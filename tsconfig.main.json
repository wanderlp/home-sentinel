{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": "./src",
    "outDir": "./dist",
    "types": ["node"],
    "sourceMap": true
  },
  "include": [
    "src/app/main/**/*.ts",
    "src/core/**/*.ts",
    "src/shared/**/*.ts"
  ],
  "exclude": [
    "src/app/preload/**/*",
    "src/app/renderer/**/*"
  ]
}
